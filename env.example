# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=wallet_system

# Redis (Bull broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Application
PORT=3000
NODE_ENV=development

# JWT — required in production (16+ characters, not a placeholder)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
